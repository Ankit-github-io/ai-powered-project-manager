# ==========================================
# 🌍 GLOBAL / DEPENDENCIES & PACKAGES
# ==========================================
**/node_modules
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Env files (Crucial Security)
**/.env*

# ==========================================
# 🎨 FRONTEND (NEXT.JS) & VERCEL SPECIFIC
# ==========================================
**/.next/
**/out/
**/build/
**/next-env.d.ts
**/.vercel

# ==========================================
# 💻 BACKEND (NESTJS & BUILD) SPECIFIC
# ==========================================
**/dist/
**/*.tsbuildinfo

# ==========================================
# 🛠️ TESTING, DEBUG & LOGS
# ==========================================
**/coverage
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# ==========================================
# 🖥️ OS & MISC SECURITY
# ==========================================
.DS_Store
Thumbs.db
**/*.pem