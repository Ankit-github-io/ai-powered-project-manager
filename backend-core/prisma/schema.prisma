datasource db {
  provider = "postgresql"
}
 
generator client {
  provider = "prisma-client-js"
}

// 1. User Model (Connected via NextAuth / Google OAuth)
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  workspaces    WorkspaceMember[]
  assignedTasks Task[]         @relation("AssignedTasks")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 2. Workspace Model (Team / Organization Level)
model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  stripeId    String?           @unique // Stripe Customer ID for Billing
  plan        String            @default("FREE") // FREE, PRO, TEAM
  members     WorkspaceMember[]
  projects    Project[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// 3. Workspace Member (Relation between User and Workspace with Roles)
model WorkspaceMember {
  id          String      @id @default(cuid())
  role        Role        @default(MEMBER) // OWNER, ADMIN, MEMBER
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([userId, workspaceId])
}

// 4. Project Model (Each Workspace can have multiple projects)
model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  key         String      @unique // e.g. "NEX" for task identifiers like NEX-1
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprints     Sprint[]
  tasks       Task[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 5. Sprint Model (For AI Roadmaps and task grouping)
model Sprint {
  id          String      @id @default(cuid())
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED) // PLANNED, ACTIVE, COMPLETED
  startDate   DateTime?
  endDate     DateTime?
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 6. Task Model (Kanban Cards / Issues)
model Task {
  id          String      @id @default(cuid())
  identifier  String      // e.g. "NEX-1"
  title       String
  description String?
  status      TaskStatus  @default(BACKLOG) // BACKLOG, TODO, IN_PROGRESS, REVIEW, DONE
  priority    Priority    @default(MEDIUM)  // LOW, MEDIUM, HIGH, URGENT
  
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  sprintId    String?
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  
  assigneeId  String?
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Enums for Status and Roles
enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}